# Copy this file to `.env` and fill in your key:
#     cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys

# ---- Required ----
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- Model (optional) ----
MODEL=claude-opus-5
MAX_TOKENS=2000
# low | medium | high | xhigh | max  — higher means more reasoning, more cost
EFFORT=medium

# ---- Retrieval tuning (optional) ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6
# Minimum combined relevance score (0..1) for a question to count as in-scope.
# Raise it to make the bot stricter, lower it to make it more permissive.
# 0.40 is tuned against the bundled examples; see docs/scope-tuning.md.
RELEVANCE_FLOOR=0.40

# ---- Behaviour (optional) ----
STRICT_SCOPE=true
MAX_UPLOAD_MB=25
DATA_DIR=./data
